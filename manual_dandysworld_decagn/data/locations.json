      "name": "Family Bond: Flutter/Flyte", 
      "region": "Start", 
      "category": ["Bonds"], 
      "requires": "|Flutter| OR |Flyte|",
      "hint_entrance": "Complete a floor with Flutter and Flyte as either twisteds or toons, while playing as one of them."
    },
