{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "core": {
        "goal":{
            "_comment": [
                "Using 'goal' as the name of an option let you override some of the generated goal parameters"
            ],
            "display_name": "The End Objective",
            "description": [
                "How to End your Randomized playthrough.",
                "Currently this is simply achieved by beating a specific floor number",
                "or by beating Dyle's floor"
            ],
            "aliases": {"easiest": 0},
            "hidden": false
        },
        "death_link": {
            "default": false
        },
        "filler_traps": {
            "_comment": "Using values here let you set a 'recommended' filler_trap percentage or even a default percentage",
            "values": {
                "recommended": 20
            }
        }
    },
    "user": {
        "Final_Floor_Num":{
            "type": "Range",
            "display_name": "Final Floor Number",
            "range_start": 1,
            "range_end": 100,
            "default": 20,
            "group": "Goal_Options",
            "description": [
                "The selected final floor for the Beat Final Floor goal.",
                "This value is saved in the generated slot data for future floor-progression logic.",
                "Until floor progression is implemented, use this value as a reminder of the intended goal floor."
            ]
        },
        "Number_Of_Toons_To_Reach_Goal":{
            "type": "Range",
            "display_name": "Toons Required for Goal",
            "range_start": 1,
            "range_end": 40,
            "default": 1,
            "group": "Goal_Options",
            "description": [
                "Here you can specify how many toons you must reach the goal with in order to win.",
                "Used by Any and Random goal modes; Specific mode instead requires every toon in Toons_To_Win_With.",
                "Because there are 40 toons in the game, you can set this value to any number between 1 and 40.",
                "DEFAULT: 1"
            ]
        },
        "Toons_Required":{
            "type": "Choice",
            "display_name": "Toons Required to beat the goal",
            "values": {
                "Any": 0,
                "Random": 1,
                "Specific": 2
            },
            "default": 0,
            "group": "Goal_Options",
            "description": [
                "Choose whether the goal requires a number of toons, a random selection of specific toons, or specifically named toons.",
                "The selected toon requirements are checked at the chosen victory location."
            ]
        },
        "Toons_To_Win_With":{
            "type": "OptionSet",
            "display_name": "Toons Required for Goal (Specific)",
            "group": "Goal_Options",
            "values": [
                "Blot", "Boxten", "Brightney", "Brusha", "Connie", "Cosmo", "Finn", "Flutter",
                "Gigi", "Glisten", "Goob", "Looey", "Poppy", "Razzle&Dazzle", "Rodger", "Scraps",
                "Shrimpo", "Squirm", "Teagan", "Tisha", "Toodles", "Waxwell", "Yatta", "Astro",
                "Bassie", "Bobette", "Gourdy", "Pebble", "Shelly", "Sprout", "Vee", "Cocoa",
                "Eggson", "Flyte", "Eclipse", "Ribecca", "Soulvester", "Coal_Toon", "Ginger", "Rudie"
            ],
            "default": [],
            "description": [
                "In Specific mode, every toon listed here is required at the victory location.",
                "Enter toon names as a YAML list, for example: [Astro, Razzle&Dazzle, Pebble]."
            ]
        },
        "Starting_Toons":{
            "type": "OptionSet",
            "display_name": "Starting Toons",
            "group": "Starting_Options",
            "values": [
                "Random",
                "Blot", "Boxten", "Brightney", "Brusha", "Connie", "Cosmo", "Finn", "Flutter",
                "Gigi", "Glisten", "Goob", "Looey", "Poppy", "Razzle&Dazzle", "Rodger", "Scraps",
                "Shrimpo", "Squirm", "Teagan", "Tisha", "Toodles", "Waxwell", "Yatta", "Astro",
                "Bassie", "Bobette", "Gourdy", "Pebble", "Shelly", "Sprout", "Vee", "Cocoa",
                "Eggson", "Flyte", "Eclipse", "Ribecca", "Soulvester", "Coal_Toon", "Ginger", "Rudie"
            ],
            "default": ["Random"],
            "description": [
                "Choose one or more toons to start with. The default is one random.",
                "Can start with multiple toons for example:",
                "[\"Razzle&Dazzle\", \"Random\"] Would start with Razzle&Dazzle and a random toon.",
                "At least one starting toon is always required."
            ]
        },
        "Include_Toons":{
            "type": "OptionSet",
            "display_name": "Include Toons",
            "group": "Content_Options",
            "values": [
                "Blot", "Boxten", "Brightney", "Brusha", "Connie", "Cosmo", "Finn", "Flutter",
                "Gigi", "Glisten", "Goob", "Looey", "Poppy", "Razzle&Dazzle", "Rodger", "Scraps",
                "Shrimpo", "Squirm", "Teagan", "Tisha", "Toodles", "Waxwell", "Yatta", "Astro",
                "Bassie", "Bobette", "Gourdy", "Pebble", "Shelly", "Sprout", "Vee", "Cocoa",
                "Eggson", "Flyte", "Eclipse", "Ribecca", "Soulvester", "Coal_Toon", "Ginger", "Rudie"
            ],
            "default": [],
            "description": [
                "Optional include list, for if you don't own a lot of toons. Leave empty to include all toons."
            ]
        },
        "Exclude_Toons":{
            "type": "OptionSet",
            "display_name": "Exclude Toons",
            "group": "Content_Options",
            "values": [
                "Blot", "Boxten", "Brightney", "Brusha", "Connie", "Cosmo", "Finn", "Flutter",
                "Gigi", "Glisten", "Goob", "Looey", "Poppy", "Razzle&Dazzle", "Rodger", "Scraps",
                "Shrimpo", "Squirm", "Teagan", "Tisha", "Toodles", "Waxwell", "Yatta", "Astro",
                "Bassie", "Bobette", "Gourdy", "Pebble", "Shelly", "Sprout", "Vee", "Cocoa",
                "Eggson", "Flyte", "Eclipse", "Ribecca", "Soulvester", "Coal_Toon", "Ginger", "Rudie"
            ],
            "default": [],
            "description": [
                "Optional exclusion list, for if you own most Toons. Exclusions take precedence over the include list."
            ]
        },
        "Include_Trinkets":{
            "type": "OptionSet",
            "display_name": "Include Trinkets",
            "group": "Content_Options",
            "values": [
                "Coin_Purse", "Research_Map", "Wrench", "Machine_Manual", "Speedy_Shoes", "Speedometer",
                "Thinking_Cap", "Alarm", "Thermos", "Pull_Toy", "Pop_Pack", "Megaphone", "Cooler",
                "Cardboard_Armor", "Blue_Bandana", "Paint_Bucket", "Sweet_Charm", "Clown_Horn", "Pink_Bow",
                "Brick", "Feather_Duster", "Party_Popper", "Spare_Bulb", "Ghost_Snakes_In_A_Can",
                "Fishing_Rod", "Ribbon_Spool", "Magnifying_Glass", "Fancy_Purse", "Dog_Plush", "Mime_Makeup",
                "Diary", "Lucky_Coin", "Vanity_Mirror", "Friendship_Bracelet", "Crayon_Set", "Stress_Ball",
                "Cherished_Blanket", "Star_Pillow", "Bone", "Participation_Award", "Savory_Charm",
                "Vees_Remote", "Dandy_Plush", "Egg_Radar", "Bone_Needle_And_Thread", "Festive_Lights",
                "Scrapbook", "Peppermint_Icing", "Soul_Sword", "Glazed_Fondant_Bag", "Coal_Trinket",
                "Moon_Pack_Heirloom", "Whispering_Flower", "Toy_Kit", "Memory_Locket", "Blushy_Bat", "Train_Whistle"
            ],
            "default": [],
            "description": [
                "Optional inclusion list, for if you don't own a lot of trinkets. Leave empty to include all toons."
            ]
        },
        "Exclude_Trinkets":{
            "type": "OptionSet",
            "display_name": "Exclude Trinkets",
            "group": "Content_Options",
            "values": [
                "Coin_Purse", "Research_Map", "Wrench", "Machine_Manual", "Speedy_Shoes", "Speedometer",
                "Thinking_Cap", "Alarm", "Thermos", "Pull_Toy", "Pop_Pack", "Megaphone", "Cooler",
                "Cardboard_Armor", "Blue_Bandana", "Paint_Bucket", "Sweet_Charm", "Clown_Horn", "Pink_Bow",
                "Brick", "Feather_Duster", "Party_Popper", "Spare_Bulb", "Ghost_Snakes_In_A_Can",
                "Fishing_Rod", "Ribbon_Spool", "Magnifying_Glass", "Fancy_Purse", "Dog_Plush", "Mime_Makeup",
                "Diary", "Lucky_Coin", "Vanity_Mirror", "Friendship_Bracelet", "Crayon_Set", "Stress_Ball",
                "Cherished_Blanket", "Star_Pillow", "Bone", "Participation_Award", "Savory_Charm",
                "Vees_Remote", "Dandy_Plush", "Egg_Radar", "Bone_Needle_And_Thread", "Festive_Lights",
                "Scrapbook", "Peppermint_Icing", "Soul_Sword", "Glazed_Fondant_Bag", "Coal_Trinket",
                "Moon_Pack_Heirloom", "Whispering_Flower", "Toy_Kit", "Memory_Locket", "Blushy_Bat", "Train_Whistle"
            ],
            "default": [],
            "description": [
                "Optional exclusion list, for if you own most Trinkets. Exclusions take precedence over the include list."
            ]
        },
        "Event_Twisteds":{
            "type": "Choice",
            "display_name": "Enable Event Twisted Location Checks",
            "default": "None",
            "values": {
                "None": 0,
                "Christmas": 1,
                "Easter": 2,
                "Halloween": 3
            },
            "group": "Content_Options",
            "description": [
                "Enable or disable the seasonal event Twisted location checks.",
                "This only affects the event Twisted checks, not event toons or trinkets.",
                "Currently the only seasonal events are \"Christmas\", \"Easter\", and \"Hallowee\".",
                "Leave as \"None\" to only stick to original twisteds."
            ]
        },
        "_commented_out_option":{
            "type": "Toggle",
            "default": true
        },
        "_Example_Toggle":{
            "description": [
                "This is a Toggle",
                "A simple boolean, aka True or False set the initial value with \"default\""
            ],
            "type": "Toggle",
            "default": false,
            "group": "Example Options"
        },
        "_Example_Choice":{
            "type": "Choice",
            "description": [
                "This is a Choice",
                "Let the user pick from a list of values",
                "allow_custom_value let a player define their own text value",
                "Currently the only use for Choice in Manual outside of hooks is the goal"
            ],
            "values": {
                "start":0,
                "test":1
             },
            "default": 0,
            "allow_custom_value": false,
            "group": "Example Options"
        },
        "_Example_Range":{
            "type": "Range",
            "description": [
                "This is a Range",
                "Allow the player to specify a value between 'start' and 'end'",
                "if you include a \"values\" you can define the label for certain values",
                "Currently the only use for Range in Manual outside of hooks is 'filler_trap'"
            ],
            "range_start": 0,
            "default": 1,
            "range_end": 5,
            "values": {"example": 2},
            "group": "Example Options"
        },

        "_DLC_enabled":{
            "display_name": "DLC Enabled",
            "description": "Is the Dlc enabled?",
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ],
            "default": true
        }
    }

}
