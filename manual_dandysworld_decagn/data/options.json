{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "core": {
        "goal":{
            "_comment": [
                "Using 'goal' as the name of an option let you override some of the generated goal parameters"
            ],
            "display_name": "The End Objective",
            "description": [
                "How to End your Randomized playthrough.",
                "Currently this is simply achieved by beating a specific floor number",
                "or by beating Dyle's floor"
            ],
            "aliases": {"easiest": 0},
            "hidden": false
        },
        "death_link": {
            "default": false
        },
        "filler_traps": {
            "_comment": "Using values here let you set a 'recommended' filler_trap percentage or even a default percentage",
            "values": {
                "recommended": 20
            }
        }
    },
    "user": {
        "Final_Floor_Num":{
            "type": "Range",
            "display_name": "Final Floor Number",
            "range_start": 1,
            "range_end": 100,
            "default": 25,
            "group": "Goal_Options",
            "description": [
                "The selected final floor for the Beat Final Floor goal.",
                "This value is currently not used in logic and just changes the goal name.", 
                "Value is only relevant when \"Final Floor Goal\" is selected.", 
                "Logic should use relevant values of floors 43/45 or floor 6 for dyle/dandy goals."
            ]
        },
        "Number_Of_Toons_To_Reach_Goal":{
            "type": "Range",
            "display_name": "Toons Required for Goal",
            "range_start": 1,
            "range_end": 40,
            "default": 1,
            "group": "Goal_Options",
            "description": [
                "Here you can specify how many toons you must reach the goal with in order to win.",
                "Used by Any and Random in \"Toons_Required\"; This is ignored if the \"Specific\" option is selected",
                "Because there are 40 toons in the game, you can set this value to any number between 1 and 40."
            ]
        },
        "Toons_Required":{
            "type": "Choice",
            "display_name": "Toons Required to beat the goal",
            "values": {
                "Any": 0,
                "Random": 1,
                "Specific": 2
            },
            "default": 0,
            "group": "Goal_Options",
            "description": [
                "Choose whether the goal requires any toon/s, a random toon or set of toons, or specific named toons.", 
                "Specific requires toons to be named below and ignores the \"Number_Of_Toons_To_Reach_Goal\" value."
            ]
        },
        "Toons_To_Win_With":{
            "type": "OptionSet",
            "display_name": "Toons Required for Goal (Specific)",
            "group": "Goal_Options",
            "values": [
                "Astro", "Bassie", "Blot", "Bobette", "Boxten", "Brightney", "Brusha", "Coal_Toon", "Cocoa", "Connie", 
                "Cosmo", "Eclipse", "Eggson", "Finn", "Flutter", "Flyte", "Gigi", "Ginger", "Glisten", "Goob", "Gourdy", 
                "Looey", "Pebble", "Poppy", "Razzle_&_Dazzle", "Ribecca", "Rodger", "Rudie", "Scraps", "Shelly", 
                "Shrimpo", "Soulvester", "Sprout", "Squirm", "Teagan", "Tisha", "Toodles", "Vee", "Waxwell", "Yatta" 
            ],
            "default": [],
            "description": [
                "In Specific mode, every toon listed here is required at the victory location.",
                "Enter toon names as a YAML list, for example: [Astro, Razzle_&_Dazzle, Pebble]."
            ]
        },
        "Starting_Toons":{
            "type": "OptionSet",
            "display_name": "Starting Toons",
            "group": "Starting_Options",
            "values": [
                "Astro", "Bassie", "Blot", "Bobette", "Boxten", "Brightney", "Brusha", "Coal_Toon", "Cocoa", "Connie", 
                "Cosmo", "Eclipse", "Eggson", "Finn", "Flutter", "Flyte", "Gigi", "Ginger", "Glisten", "Goob", "Gourdy", 
                "Looey", "Pebble", "Poppy", "Razzle_&_Dazzle", "Ribecca", "Rodger", "Rudie", "Scraps", "Shelly", 
                "Shrimpo", "Soulvester", "Sprout", "Squirm", "Teagan", "Tisha", "Toodles", "Vee", "Waxwell", "Yatta" 
            ],
            "default": ["Boxten", "Poppy"],
            "description": [
                "Choose one or more toons to start with. Below is a list of toon names for quick reference if needed:",
                ["Astro", "Bassie", "Blot", "Bobette", "Boxten", "Brightney", "Brusha", "Coal_Toon", "Cocoa", "Connie", 
                "Cosmo", "Eclipse", "Eggson", "Finn", "Flutter", "Flyte", "Gigi", "Ginger", "Glisten", "Goob", "Gourdy", 
                "Looey", "Pebble", "Poppy", "Razzle_&_Dazzle", "Ribecca", "Rodger", "Rudie", "Scraps", "Shelly", 
                "Shrimpo", "Soulvester", "Sprout", "Squirm", "Teagan", "Tisha", "Toodles", "Vee", "Waxwell", "Yatta"], 
                "If left blank, defaults to selecting a random toon to start with.",
                "WARNING: It is recommended to only start with less than 5 toons, otherwise too much early logic."
            ]
        },
        "Random_Starting_Toons":{
            "type": "Range",
            "range_start": 0,
            "range_end": 39,
            "default": 0,
            "group": "Starting_Options",
            "description": [
                "This setting is optional, for those who wish to start with Random Toons.", 
                "The previous option for starting toons is prioritised over this, and this option adds additional toons.",
                "Because there are 40 toons in the game, you can set this value to any number between 0 and 40.",
                "WARNING: It is recommended to only start with less than 5 toons, otherwise too much early logic."
            ]
        },
        "Include_Toons":{
            "type": "OptionSet",
            "display_name": "Include Toons",
            "group": "Content_Options",
            "values": [
                "Astro", "Bassie", "Blot", "Bobette", "Boxten", "Brightney", "Brusha", "Coal_Toon", "Cocoa", "Connie", 
                "Cosmo", "Eclipse", "Eggson", "Finn", "Flutter", "Flyte", "Gigi", "Ginger", "Glisten", "Goob", "Gourdy", 
                "Looey", "Pebble", "Poppy", "Razzle_&_Dazzle", "Ribecca", "Rodger", "Rudie", "Scraps", "Shelly", 
                "Shrimpo", "Soulvester", "Sprout", "Squirm", "Teagan", "Tisha", "Toodles", "Vee", "Waxwell", "Yatta" 
            ],
            "default": [
                "Astro", "Bassie", "Blot", "Bobette", "Boxten", "Brightney", "Brusha", "Coal_Toon", "Cocoa", "Connie", 
                "Cosmo", "Eclipse", "Eggson", "Finn", "Flutter", "Flyte", "Gigi", "Ginger", "Glisten", "Goob", "Gourdy", 
                "Looey", "Pebble", "Poppy", "Razzle_&_Dazzle", "Ribecca", "Rodger", "Rudie", "Scraps", "Shelly", 
                "Shrimpo", "Soulvester", "Sprout", "Squirm", "Teagan", "Tisha", "Toodles", "Vee", "Waxwell", "Yatta" 
            ],
            "description": [
                "The inclusion list for what toons are available as items to receive.",
                "Remove any you don't own. Leaving this field empty will include all toons."
            ]
        },
        "Include_Trinkets":{
            "type": "OptionSet",
            "display_name": "Include Trinkets",
            "group": "Content_Options",
            "values": [
                "Alarm", "Blue_Bandana", "Blushy_Bat", "Bone", "Bone_Needle_And_Thread", "Brick", "Cardboard_Armor", 
                "Cherished_Blanket", "Clown_Horn", "Coal_Trinket", "Coin_Purse", "Cooler", "Crayon_Set", "Dandy_Plush", 
                "Diary", "Dog_Plush", "Egg_Radar", "Fancy_Purse", "Feather_Duster", "Festive_Lights", "Fishing_Rod", 
                "Friendship_Bracelet", "Ghost_Snakes_In_A_Can", "Glazed_Fondant_Bag", "Lucky_Coin", "Machine_Manual", 
                "Magnifying_Glass", "Megaphone", "Memory_Locket", "Mime_Makeup", "Moon_Pack_Heirloom", "Paint_Bucket", 
                "Participation_Award", "Party_Popper", "Peppermint_Icing", "Pink_Bow", "Pop_Pack", "Pull_Toy", 
                "Research_Map", "Ribbon_Spool", "Savory_Charm", "Scrapbook", "Soul_Sword", "Spare_Bulb", "Speedometer", 
                "Speedy_Shoes", "Star_Pillow", "Stress_Ball", "Sweet_Charm", "Thermos", "Thinking_Cap", "Toy_Kit", 
                "Train_Whistle", "Vanity_Mirror", "Vees_Remote", "Whispering_Flower", "Wrench" 
            ],
            "default": [
                "Alarm", "Blue_Bandana", "Blushy_Bat", "Bone", "Bone_Needle_And_Thread", "Brick", "Cardboard_Armor", 
                "Cherished_Blanket", "Clown_Horn", "Coal_Trinket", "Coin_Purse", "Cooler", "Crayon_Set", "Dandy_Plush", 
                "Diary", "Dog_Plush", "Egg_Radar", "Fancy_Purse", "Feather_Duster", "Festive_Lights", "Fishing_Rod", 
                "Friendship_Bracelet", "Ghost_Snakes_In_A_Can", "Glazed_Fondant_Bag", "Lucky_Coin", "Machine_Manual", 
                "Magnifying_Glass", "Megaphone", "Memory_Locket", "Mime_Makeup", "Moon_Pack_Heirloom", "Paint_Bucket", 
                "Participation_Award", "Party_Popper", "Peppermint_Icing", "Pink_Bow", "Pop_Pack", "Pull_Toy", 
                "Research_Map", "Ribbon_Spool", "Savory_Charm", "Scrapbook", "Soul_Sword", "Spare_Bulb", "Speedometer", 
                "Speedy_Shoes", "Star_Pillow", "Stress_Ball", "Sweet_Charm", "Thermos", "Thinking_Cap", "Toy_Kit", 
                "Train_Whistle", "Vanity_Mirror", "Vees_Remote", "Whispering_Flower", "Wrench" 
            ],
            "description": [
                "The inclusion list for what trinkets are available as items to receive.",
                "Remove any you don't own. Leaving this field empty will include all trinkets."
            ]
        },
        "Enable_Lethal_Twisteds":{
            "type": "Toggle",
            "display_name": "Enable Lethal Twisted Location Checks",
            "default": true,
            "group": "Content_Options",
            "description": [
                "Enable or disable the Lethal Twisted location checks."
            ]
        },
        "Enable_Event_Twisteds":{
            "type": "Choice",
            "display_name": "Enable Event Twisted Location Checks",
            "default": "none",
            "values": {
                "none": 0,
                "christmas": 1,
                "easter": 2,
                "halloween": 3
            },
            "group": "Content_Options",
            "description": [
                "Enable or disable the seasonal event Twisted location checks.",
                "This only affects the event Twisted checks, not event toons or trinkets.",
                "Currently the only seasonal events are \"christmas\", \"easter\", and \"halloween\".",
                "Leave on \"none\" to only stick to original twisteds."
            ]
        },
        "_commented_out_option":{
            "type": "Toggle",
            "default": true
        },
        "_Example_Toggle":{
            "description": [
                "This is a Toggle",
                "A simple boolean, aka True or False set the initial value with \"default\""
            ],
            "type": "Toggle",
            "default": false,
            "group": "Example Options"
        },
        "_Example_Choice":{
            "type": "Choice",
            "description": [
                "This is a Choice",
                "Let the user pick from a list of values",
                "allow_custom_value let a player define their own text value",
                "Currently the only use for Choice in Manual outside of hooks is the goal"
            ],
            "values": {
                "start":0,
                "test":1
             },
            "default": 0,
            "allow_custom_value": false,
            "group": "Example Options"
        },
        "_Example_Range":{
            "type": "Range",
            "description": [
                "This is a Range",
                "Allow the player to specify a value between 'start' and 'end'",
                "if you include a \"values\" you can define the label for certain values",
                "Currently the only use for Range in Manual outside of hooks is 'filler_trap'"
            ],
            "range_start": 0,
            "default": 1,
            "range_end": 5,
            "values": {"example": 2},
            "group": "Example Options"
        },

        "_DLC_enabled":{
            "display_name": "DLC Enabled",
            "description": "Is the Dlc enabled?",
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ],
            "default": true
        }
    }

}
